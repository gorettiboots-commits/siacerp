/* ============================================================
   SIAC ERP - Sistema de estilos global
   Estándar de apariencia: Windows Forms clásico (replica del
   módulo de Clientes, aplicado a todo el sistema)

   ?? Paleta (tokens) ?????????????????????????????????????????
   Fondo app      #F0F0F0
   Superficie     #FFFFFF
   Borde          #A0A0A0   (input #7F9DB9 / focus #0078D7)
   Botón relieve  blanco -> #E1E1E1 (borde 3D blanco/gris)
   Botón primario azul clásico #2A5FB0..#4D80D0
   Selección      #3399FF
   Texto          #000000 (secundario #444444)
   ============================================================ */

QMainWindow, QDialog {
    background-color: #F0F0F0;
}

QWidget#centralContainer, QWidget#mainContainer, QWidget#contentArea {
    background-color: #F0F0F0;
}

QWidget {
    font-size: 13px;
    color: #000000;
}

QLabel { color: #000000; }
QLabel#sectionTitle { font-size: 18px; font-weight: bold; color: #000000; }
QLabel#sectionSubtitle { font-size: 12px; color: #444444; }

/* ============================================================
   LOGIN
   ============================================================ */
QWidget#loginWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #E8E8E8, stop:1 #C8CDD4);
}

QFrame#loginCard {
    background-color: #F0F0F0;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
    padding: 28px;
}

QLabel#loginTitle {
    font-size: 22px;
    font-weight: bold;
    color: #000000;
}

QLabel#loginSubtitle {
    font-size: 13px;
    color: #444444;
}

/* ============================================================
   CAMPOS DE ENTRADA (sunken clásico)
   ============================================================ */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit,
QDateTimeEdit, QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #7F9DB9;
    border-radius: 0px;
    padding: 3px 6px;
    color: #000000;
    selection-background-color: #3399FF;
    selection-color: #FFFFFF;
    min-height: 20px;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover, QTextEdit:hover {
    border: 1px solid #0078D7;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QTextEdit:focus {
    border: 1px solid #0078D7;
    background-color: #FFFFFF;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateEdit:disabled, QTimeEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #F0F0F0;
    color: #808080;
    border-color: #C0C0C0;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url("@ASSETS@/chevron.svg");
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #7A7A7A;
    color: #000000;
    selection-background-color: #3399FF;
    selection-color: #FFFFFF;
    outline: none;
}
QComboBox QAbstractItemView::item { padding: 4px 8px; }

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 18px;
    border: 1px solid #A0A0A0;
    background: #E8E8E8;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #000000;
    margin-top: 4px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #000000;
    margin-bottom: 4px;
}

/* ============================================================
   CHECKBOX / RADIO
   ============================================================ */
QCheckBox, QRadioButton { spacing: 6px; color: #000000; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #7A7A7A;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #0078D7;
}
QCheckBox::indicator:checked {
    background-color: #0078D7;
    border: 1px solid #005A9E;
    image: url("@ASSETS@/check.svg");
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #F0F0F0;
    border-color: #C0C0C0;
}
QRadioButton::indicator:checked {
    background-color: #FFFFFF;
    border: 5px solid #0078D7;
}

/* ============================================================
   BOTONES (relieve 3D clásico)
   ============================================================ */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #FCFCFC, stop:1 #E1E1E1);
    border: 2px solid;
    border-color: #FFFFFF #848484 #848484 #FFFFFF;
    border-radius: 0px;
    padding: 6px 16px;
    font-weight: normal;
    color: #000000;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #FDFDFD, stop:1 #EAEAEA);
}
QPushButton:pressed {
    background: #DCDCDC;
    border-color: #848484 #FFFFFF #FFFFFF #848484;
}
QPushButton:focus {
    border-color: #0078D7 #0078D7 #0078D7 #0078D7;
}
QPushButton:disabled {
    background: #EFEFEF;
    color: #8A8A8A;
    border-color: #C8C8C8 #C8C8C8 #C8C8C8 #C8C8C8;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #a5b4fc;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QPushButton#btnPrimary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4D80D0, stop:1 #2A5FB0);
    border: 1px solid;
    border-color: #6FA0E0 #1E4A8F #1E4A8F #6FA0E0;
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton#btnPrimary:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5C8FD9, stop:1 #3569BE);
}
QPushButton#btnPrimary:pressed { background: #23509C; }
QPushButton#btnPrimary:disabled {
    background: #B9CBE6;
    color: #E5EEFA;
    border-color: #9BB4D8;
}

QPushButton#btnSecondary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #FCFCFC, stop:1 #E1E1E1);
    border: 1px solid #A0A0A0;
    color: #000000;
    font-weight: normal;
}
QPushButton#btnSecondary:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #FDFDFD, stop:1 #EAEAEA);
}

QPushButton#btnSuccess {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #67B96A, stop:1 #3D9141);
    border: 1px solid;
    border-color: #8CCB8E #2E6E31 #2E6E31 #8CCB8E;
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton#btnSuccess:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #77C47A, stop:1 #4AA14E);
}
QPushButton#btnSuccess:pressed { background: #337A36; }
QPushButton#btnSuccess:disabled {
    background: #C6E0C7;
    color: #F0F7F0;
    border-color: #A8CBA9;
}

QPushButton#btnDanger {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #D45B5B, stop:1 #A93A3A);
    border: 1px solid;
    border-color: #E08B8B #7E2626 #7E2626 #E08B8B;
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton#btnDanger:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #DB6E6E, stop:1 #B74444);
}
QPushButton#btnDanger:pressed { background: #8F3030; }
QPushButton#btnDanger:disabled {
    background: #E3C2C2;
    color: #F7EAEA;
    border-color: #D0A2A2;
}

QPushButton#btnWarning {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #E8A93C, stop:1 #C77E18);
    border: 1px solid;
    border-color: #F0C578 #9C5F0E #9C5F0E #F0C578;
    color: #000000;
    font-weight: bold;
}
QPushButton#btnWarning:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #EFB750, stop:1 #D18A24);
}
QPushButton#btnWarning:pressed { background: #A96814; }
QPushButton#btnWarning:disabled {
    background: #E7D6AE;
    color: #F7EFDF;
    border-color: #D3BA88;
}

QPushButton#btnModo {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
    padding: 0px;
}
QPushButton#btnModo:hover {
    background-color: #EAF3FF;
    border-color: #0078D7;
}
QPushButton#btnModo:checked {
    background-color: #BBD4F7;
    border-color: #1E4A8F;
}
QPushButton#btnModo:checked:hover {
    background-color: #C7D6EC;
}
QPushButton#btnModo:disabled {
    background-color: #F1F1F1;
    border-color: #C0C0C0;
}

QPushButton#viewSwitch {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #FCFCFC, stop:1 #E1E1E1);
    color: #000000;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
    padding: 4px 12px;
    font-size: 12px;
    min-height: 18px;
}
QPushButton#viewSwitch:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #FDFDFD, stop:1 #EAEAEA);
}
QPushButton#viewSwitch:checked {
    background: #BBD4F7;
    color: #000000;
    border: 1px solid #1E4A8F;
    font-weight: bold;
}

QPushButton#btnRowEdit {
    background-color: #FFFFFF;
    border: 1px solid #1E4A8F;
    border-radius: 17px;
    padding: 0px;
    min-height: 0px;
    max-height: 34px;
    max-width: 34px;
}
QPushButton#btnRowEdit:hover {
    background-color: #E8F0FE;
}
QPushButton#btnRowEdit:disabled {
    background-color: #F1F1F1;
    border-color: #C0C0C0;
}

QPushButton#btnRowDel {
    background-color: #FFFFFF;
    border: 1px solid #A93A3A;
    border-radius: 17px;
    padding: 0px;
    min-height: 0px;
    max-height: 34px;
    max-width: 34px;
}
QPushButton#btnRowDel:hover {
    background-color: #FBE8E8;
}
QPushButton#btnRowDel:disabled {
    background-color: #F1F1F1;
    border-color: #C0C0C0;
}

QPushButton#btnLogin {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4D80D0, stop:1 #2A5FB0);
    color: #FFFFFF;
    border: 1px solid;
    border-color: #6FA0E0 #1E4A8F #1E4A8F #6FA0E0;
    border-radius: 0px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}
QPushButton#btnLogin:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5C8FD9, stop:1 #3569BE);
}
QPushButton#btnLogin:pressed { background: #23509C; }

/* Icono circular de fila */
QToolButton#btnFilaIcono {
    background-color: #DDE7F5;
    border: 1px solid #7F9DB9;
    border-radius: 13px;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    padding: 0px;
}
QToolButton#btnFilaIcono:hover {
    background-color: #C7D6EC;
}
QToolButton#btnFilaIcono:pressed {
    background-color: #B3C6E0;
}
QToolButton#btnFilaIcono:disabled {
    background-color: transparent;
    border-color: transparent;
}

/* Icono tile de fila: sin fondo circular para apreciar el tile */
QToolButton#btnFilaIconoTile {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QToolButton#btnFilaIconoTile:hover {
    background-color: transparent;
}
QToolButton#btnFilaIconoTile:pressed {
    background-color: transparent;
}
QToolButton#btnFilaIconoTile:disabled {
    background-color: transparent;
    border-color: transparent;
}

/* ============================================================
   BARRA DE NAVEGACIÓN (toolbar superior horizontal)
   Colores por módulo — cada botón tiene su propio color.
   ============================================================ */
QFrame#navToolbar {
    background-color: #E4E9ED;
    border-bottom: 1px solid #A9A9A9;
}

QToolButton#navTool {
    background-color: transparent;
    color: #1F2937;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
QToolButton#navTool:hover {
    background-color: #C9D4D6;
}
QToolButton#navTool:pressed {
    background-color: #AEBFC2;
}
QToolButton#navTool:checked {
    background-color: #07756A;
    color: #ffffff;
    border-color: #07756A;
}

QToolButton#navToolOC {
    background-color: transparent;
    color: #1e40af;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
QToolButton#navToolOC:hover { background-color: #dbeafe; }
QToolButton#navToolOC:pressed { background-color: #bfdbfe; }
QToolButton#navToolOC:checked {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #2563eb;
}

QToolButton#navToolProduccion {
    background-color: transparent;
    color: #7c3aed;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
QToolButton#navToolProduccion:hover { background-color: #ede9fe; }
QToolButton#navToolProduccion:pressed { background-color: #ddd6fe; }
QToolButton#navToolProduccion:checked {
    background-color: #7c3aed;
    color: #ffffff;
    border-color: #7c3aed;
}

QToolButton#navToolInventario {
    background-color: transparent;
    color: #0d9488;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
QToolButton#navToolInventario:hover { background-color: #ccfbf1; }
QToolButton#navToolInventario:pressed { background-color: #99f6e4; }
QToolButton#navToolInventario:checked {
    background-color: #0d9488;
    color: #ffffff;
    border-color: #0d9488;
}

QToolButton#navToolClientes {
    background-color: transparent;
    color: #16a34a;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
QToolButton#navToolClientes:hover { background-color: #dcfce7; }
QToolButton#navToolClientes:pressed { background-color: #bbf7d0; }
QToolButton#navToolClientes:checked {
    background-color: #16a34a;
    color: #ffffff;
    border-color: #16a34a;
}

QToolButton#navToolProgramacion {
    background-color: transparent;
    color: #ea580c;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
QToolButton#navToolProgramacion:hover { background-color: #fed7aa; }
QToolButton#navToolProgramacion:pressed { background-color: #fdba74; }
QToolButton#navToolProgramacion:checked {
    background-color: #ea580c;
    color: #ffffff;
    border-color: #ea580c;
}

QToolButton#navToolSandbox {
    background-color: transparent;
    color: #ca8a04;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
QToolButton#navToolSandbox:hover { background-color: #fef9c3; }
QToolButton#navToolSandbox:pressed { background-color: #fef08a; }
QToolButton#navToolSandbox:checked {
    background-color: #ca8a04;
    color: #ffffff;
    border-color: #ca8a04;
}

QToolButton#navToolSalir {
    background-color: transparent;
    color: #dc2626;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
QToolButton#navToolSalir:hover { background-color: #fee2e2; }
QToolButton#navToolSalir:pressed { background-color: #fecaca; }

QFrame#userCard {
    background-color: transparent;
    border: none;
    padding: 0px 4px;
}
QLabel#userName {
    color: #1F2937;
    font-size: 12px;
    font-weight: 600;
}
QLabel#userRole {
    color: #6B7280;
    font-size: 11px;
}
QLabel#navBrand {
    color: #1E4A8F;
    font-weight: bold;
    font-size: 15px;
}

/* ============================================================
   HEADERS DE VISTAS
   ============================================================ */
QFrame#headerBar {
    background-color: #F0F0F0;
    border-bottom: 1px solid #A0A0A0;
}

/* ============================================================
   TARJETAS
   ============================================================ */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
}
QFrame#card:hover {
    border: 1px solid #0078D7;
}

QLabel#imgPreview {
    background-color: #F5F5F5;
    border: 1px dashed #A0A0A0;
    border-radius: 0px;
    color: #555555;
    font-size: 12px;
}

QFrame#odooCard {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
}
QFrame#odooCard:hover {
    border: 1px solid #1E4A8F;
    background-color: #F5F9FF;
}
QFrame#odooCard[selected="true"] {
    border: 2px solid #1E4A8F;
    background-color: #E8F0FE;
}
QLabel#cardBadge {
    background-color: #E8E8E8;
    color: #000000;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
}
QLabel#cardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #000000;
}
QLabel#cardValue {
    font-size: 26px;
    font-weight: bold;
    color: #1E4A8F;
}

/* ============================================================
   TABLAS
   ============================================================ */
QTableWidget, QTableView, QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
    gridline-color: #D8D8D8;
    color: #000000;
    font-size: 13px;
}
QTableWidget::item, QTableView::item, QListWidget::item {
    padding: 3px 6px;
    border: none;
}
QTableWidget::item:hover, QTableView::item:hover, QListWidget::item:hover {
    background-color: #EAF3FF;
}
QTableWidget::item:selected, QTableView::item:selected, QListWidget::item:selected {
    background-color: #3399FF;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #E8E8E8;
    border: none;
    border-right: 1px solid #A0A0A0;
    border-bottom: 1px solid #A0A0A0;
    font-weight: bold;
    color: #000000;
    padding: 5px 6px;
}
QTableCornerButton::section {
    background-color: #E8E8E8;
    border: none;
    border-right: 1px solid #A0A0A0;
    border-bottom: 1px solid #A0A0A0;
}

/* ============================================================
   TABS
   ============================================================ */
QTabWidget::pane {
    border: 1px solid #A0A0A0;
    background-color: #F0F0F0;
    top: -1px;
}
QTabBar::tab {
    background: #E0E0E0;
    border: 1px solid #A0A0A0;
    border-bottom: none;
    padding: 6px 18px;
    color: #000000;
    font-weight: normal;
}
QTabBar::tab:selected {
    background: #F0F0F0;
    color: #000000;
    font-weight: bold;
}
QTabBar::tab:hover { background: #EAEAEA; }

/* ============================================================
   GROUPBOX
   ============================================================ */
QGroupBox {
    background-color: #F0F0F0;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
    margin-top: 10px;
    padding: 12px 8px 8px 8px;
    font-weight: bold;
    font-size: 13px;
    color: #000000;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    background-color: #F0F0F0;
}

/* ============================================================
   PROGRESSBAR
   ============================================================ */
QProgressBar {
    border: 1px solid #A0A0A0;
    border-radius: 0px;
    background-color: #FFFFFF;
    height: 14px;
    text-align: center;
    font-size: 10px;
    color: #000000;
}
QProgressBar::chunk {
    background-color: #2A5FB0;
}

/* ============================================================
   KANBAN
   ============================================================ */
QFrame#kanbanCard {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
    padding: 12px;
}
QFrame#kanbanCard:hover {
    border: 1px solid #1E4A8F;
}
QLabel#kanbanTitle {
    font-size: 14px;
    font-weight: bold;
    color: #000000;
}
QLabel#kanbanStatus {
    font-size: 11px;
    padding: 2px 8px;
    border: 1px solid #A0A0A0;
    border-radius: 0px;
}
QLabel#kanbanStatus[estatus="pendiente"] {
    background-color: #FFF7CC;
    color: #5C4A00;
}
QLabel#kanbanStatus[estatus="en_proceso"] {
    background-color: #DCE9FB;
    color: #1E4A8F;
}
QLabel#kanbanStatus[estatus="completado"] {
    background-color: #DDF0DF;
    color: #2E6E31;
}

/* ============================================================
   SCROLLBARS clásicas
   ============================================================ */
QScrollBar:vertical {
    background: #F0F0F0;
    width: 16px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #C8C8C8;
    border: 1px solid #9C9C9C;
    min-height: 22px;
}
QScrollBar::handle:vertical:hover { background: #B4B4B4; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 16px;
    background: #E0E0E0;
    border: 1px solid #9C9C9C;
}
QScrollBar:horizontal {
    background: #F0F0F0;
    height: 16px;
}
QScrollBar::handle:horizontal {
    background: #C8C8C8;
    border: 1px solid #9C9C9C;
    min-width: 22px;
}
QScrollBar::handle:horizontal:hover { background: #B4B4B4; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 16px;
    background: #E0E0E0;
    border: 1px solid #9C9C9C;
}
QScrollBar::add-line:hover, QScrollBar::sub-line:hover { background: #D0D0D0; }

/* ============================================================
   SCROLLAREA / LISTAS
   ============================================================ */
QScrollArea {
    border: none;
    background: transparent;
}
QListWidget::item:hover { background-color: #EAF3FF; }
QListWidget::item:selected {
    background-color: #3399FF;
    color: #FFFFFF;
}

/* ============================================================
   MENÚ
   ============================================================ */
QMenuBar {
    background-color: #E8E8E8;
    color: #000000;
    padding: 2px;
}
QMenuBar::item {
    padding: 6px 12px;
    border-radius: 0px;
}
QMenuBar::item:selected {
    background-color: #BBD4F7;
    color: #000000;
}
QMenu {
    background-color: #F0F0F0;
    color: #000000;
    border: 1px solid #A0A0A0;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 0px;
}
QMenu::item:selected {
    background-color: #BBD4F7;
    color: #000000;
}

/* ============================================================
   STATUS BAR
   ============================================================ */
QStatusBar {
    background-color: #E8E8E8;
    color: #000000;
    border-top: 1px solid #A0A0A0;
    font-size: 12px;
    padding: 4px 8px;
}
QStatusBar QLabel {
    color: #000000;
}

/* ============================================================
   TOOLTIP
   ============================================================ */
QToolTip {
    background-color: #FFFFE1;
    color: #000000;
    border: 1px solid #000000;
    padding: 4px 8px;
    border-radius: 0px;
    font-size: 12px;
}

/* ============================================================
   MENSAJES / INPUT / BUTTONBOX
   ============================================================ */
QMessageBox {
    background-color: #F0F0F0;
}
QMessageBox QLabel {
    font-size: 13px;
    color: #000000;
}

QInputDialog QLabel {
    font-size: 13px;
    color: #000000;
}

QMessageBox QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    min-width: 88px;
}

QMessageBox QPushButton:hover {
    background-color: #f8fafc;
    border-color: #a5b4fc;
}

QMessageBox QPushButton:pressed {
    background-color: #e2e8f0;
}

QMessageBox QPushButton:default,
QMessageBox QPushButton#qt_msgbox_okbutton,
QMessageBox QPushButton#qt_msgbox_yesbutton,
QMessageBox QPushButton#qt_msgbox_yesallbutton {
    background-color: #4f46e5;
    color: #ffffff;
    border: none;
}

QMessageBox QPushButton:default:hover,
QMessageBox QPushButton#qt_msgbox_okbutton:hover,
QMessageBox QPushButton#qt_msgbox_yesbutton:hover,
QMessageBox QPushButton#qt_msgbox_yesallbutton:hover {
    background-color: #4338ca;
}

/* ---- InputDialog ---- */
QInputDialog QLabel {
    font-size: 13px;
    color: #1f2937;
}

QInputDialog QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    min-width: 88px;
}

QInputDialog QPushButton:hover {
    background-color: #f8fafc;
    border-color: #a5b4fc;
}

QInputDialog QPushButton:pressed {
    background-color: #e2e8f0;
}

QInputDialog QPushButton:default {
    background-color: #4f46e5;
    color: #ffffff;
    border: none;
}

QInputDialog QPushButton:default:hover {
    background-color: #4338ca;
}

/* ---- DialogButtonBox ---- */
QDialogButtonBox QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    min-width: 88px;
}

QDialogButtonBox QPushButton:hover {
    background-color: #f8fafc;
    border-color: #a5b4fc;
}

QDialogButtonBox QPushButton:pressed {
    background-color: #e2e8f0;
}

QDialogButtonBox QPushButton:default {
    background-color: #4f46e5;
    color: #ffffff;
    border: none;
}

QDialogButtonBox QPushButton:default:hover {
    background-color: #4338ca;
}

/* ============================================================
   CALENDARIO
   ============================================================ */
QCalendarWidget QWidget { background-color: #FFFFFF; color: #000000; }
QCalendarWidget QToolButton {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: #000000;
    font-weight: bold;
    padding: 4px 8px;
}
QCalendarWidget QToolButton:hover { background: #E0E0E0; }
QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #000000;
    selection-background-color: #3399FF;
    selection-color: #FFFFFF;
    border: none;
}
QCalendarWidget QWidget#qt_calendar_navigationbar { background-color: #F0F0F0; }
QCalendarWidget QWidget#qt_calendar_weekday { color: #000000; font-weight: bold; }

/* ============================================================
   DIÁLOGO DE CONFIGURACIÓN (panel lateral)
   ============================================================ */
QDialog#dlgConfiguracion {
    background-color: #F0F0F0;
}
QLabel#cfgDialogTitle {
    background-color: #F0F0F0;
    font-size: 22px;
    font-weight: bold;
    color: #000000;
    padding: 16px 24px 8px 24px;
}
QFrame#cfgSidebar {
    background-color: #E8E8E8;
    border: none;
    border-right: 1px solid #A0A0A0;
}
QPushButton#cfgSidebarItem {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    text-align: left;
}
QPushButton#cfgSidebarItem:hover {
    background-color: #D0D0D0;
}
QPushButton#cfgSidebarItem:checked {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
}
QPushButton#cfgSidebarItem:checked:hover {
    background-color: #FFFFFF;
}
QLabel#cfgSidebarItemLabel {
    background-color: transparent;
    border: none;
    color: #000000;
    font-size: 14px;
    font-weight: 500;
}
QFrame#cfgContent {
    background-color: #F0F0F0;
    border: none;
}
QLabel#cfgSectionTitle {
    background-color: transparent;
    font-size: 18px;
    font-weight: bold;
    color: #000000;
}
QLabel#cfgSectionSubtitle {
    background-color: transparent;
    font-size: 12px;
    color: #444444;
}
QFrame#cfgDivider {
    background-color: #A0A0A0;
    border: none;
}

/* ============================================================
   NOTIFICACIONES FLOTANTES (toast)
   ============================================================ */
QFrame#toastCard {
    background-color: #F0F0F0;
    border: 1px solid #7F9DB9;
    border-radius: 0px;
}
QLabel#toastTitulo {
    color: #000000;
    font-size: 13px;
    font-weight: bold;
}
QLabel#toastMsg {
    color: #333333;
    font-size: 12px;
}
QPushButton#toastCerrar {
    background-color: transparent;
    color: #555555;
    border: none;
    border-radius: 0px;
    padding: 4px 8px;
    font-size: 14px;
}
QPushButton#toastCerrar:hover {
    background-color: #E0E0E0;
    color: #000000;
}

/* ============================================================
   BUSCADOR GLOBAL (Ctrl+K)
   ============================================================ */
QWidget#searchPalette {
    background-color: #FFFFFF;
    border: 1px solid #A0A0A0;
    border-radius: 8px;
}

QLineEdit#searchInput {
    background-color: #F5F5F5;
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 15px;
    color: #000000;
    selection-background-color: #3399FF;
}

QLineEdit#searchInput:focus {
    border-color: #2A5FB0;
}

QLabel#searchHint {
    font-size: 11px;
    color: #888888;
    padding-left: 28px;
}

QListWidget#searchResults {
    background-color: transparent;
    border: none;
    padding: 4px 0px;
    font-size: 13px;
    color: #000000;
    outline: none;
}

QListWidget#searchResults::item {
    padding: 6px 8px;
    border-radius: 4px;
    margin: 1px 2px;
}

QListWidget#searchResults::item:selected {
    background-color: #E8F0FE;
    color: #000000;
}

QListWidget#searchResults::item:hover:!selected {
    background-color: #F0F0F0;
}
