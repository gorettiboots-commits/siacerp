/* ============================================================
   SIAC ERP - Sistema de estilos global
   Estándar de apariencia: Windows 11 Fluent
   Identidad de marca conservada (acento índigo)

   ── Paleta (tokens) ─────────────────────────────────────────
   Acento          #4f46e5   (hover #4338ca / pressed #3730a3)
   Acento-suave    #eef2ff   #e0e7ff
   Fondo app       #f5f6f8
   Superficie      #ffffff
   Borde           #e2e8f0   (hover #cbd5e1)
   Texto           #1e293b   (secundario #64748b / tenue #94a3b8)
   Sidebar         #1e293b   (panel #0f172a / hover #334155)
   Éxito           #059669   (hover #047857)
   Peligro         #dc2626   (hover #b91c1c)
   Advertencia     #d97706   (hover #b45309)

   ── Reglas de diseño ────────────────────────────────────────
   · Equilibrio: moderno pero denso (estilo ERP Windows clásico)
   · Espaciado base 4/8dp — compacto sin apretar
   · Alturas: inputs 32px, botones 32px, filas tabla ~36px
   · Focus siempre visible (ring 2px índigo)
   · Un solo CTA primario por pantalla
   ============================================================ */

QMainWindow, QDialog {
    background-color: #f5f6f8;
}

QWidget#centralContainer {
    background-color: #f5f6f8;
}

QWidget#mainContainer, QWidget#contentArea {
    background-color: #f5f6f8;
}

QWidget {
    font-size: 13px;
    color: #1e293b;
}

/* ============================================================
   LOGIN
   ============================================================ */
QWidget#loginWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1e293b, stop:1 #0f172a);
}

QFrame#loginCard {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 40px;
}

QLabel#loginTitle {
    font-size: 28px;
    font-weight: bold;
    color: #111827;
}

QLabel#loginSubtitle {
    font-size: 13px;
    color: #6b7280;
}

/* ============================================================
   CAMPOS DE ENTRADA
   ============================================================ */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit,
QDateTimeEdit {
    padding: 5px 10px;
    min-height: 18px;
    border: 1px solid #d0d5dd;
    border-radius: 6px;
    font-size: 13px;
    background-color: #ffffff;
    color: #1e293b;
    selection-background-color: #e0e7ff;
    selection-color: #1e1b4b;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover {
    border-color: #a5b4fc;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 2px solid #4f46e5;
    background-color: #ffffff;
    padding: 4px 9px;  /* compensa el borde de 2px para no saltar */
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateEdit:disabled, QTimeEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QTextEdit {
    padding: 5px 10px;
    border: 1px solid #d0d5dd;
    border-radius: 6px;
    font-size: 13px;
    background-color: #ffffff;
    color: #1e293b;
    selection-background-color: #e0e7ff;
}

QTextEdit:hover {
    border-color: #a5b4fc;
}

QTextEdit:focus {
    border: 2px solid #4f46e5;
    background-color: #ffffff;
    padding: 4px 9px;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url("@ASSETS@/chevron.svg");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #d0d5dd;
    border-radius: 8px;
    background-color: #ffffff;
    color: #1f2937;
    padding: 6px;
    selection-background-color: #eef2ff;
    selection-color: #4f46e5;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 4px;
    color: #1f2937;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f1f5f9;
    color: #1f2937;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #eef2ff;
    color: #4f46e5;
}

/* ---- Checkbox / Radio ---- */
QCheckBox, QRadioButton {
    spacing: 6px;
    font-size: 13px;
    color: #334155;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator {
    border-radius: 4px;
    border: 2px solid #cbd5e1;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #6366f1;
}

QCheckBox::indicator:checked {
    border-color: #4f46e5;
    background-color: #4f46e5;
    image: url("@ASSETS@/check.svg");
}

QCheckBox::indicator:checked:hover {
    background-color: #4338ca;
}

QCheckBox::indicator:disabled {
    border-color: #e2e8f0;
    background-color: #f1f5f9;
}

QRadioButton::indicator {
    border-radius: 9px;
    border: 2px solid #cbd5e1;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #6366f1;
}

QRadioButton::indicator:checked {
    border: 5px solid #4f46e5;
    background-color: #ffffff;
}

/* ============================================================
   MENÚ (barra superior)
   ============================================================ */
QMenuBar {
    background-color: #1e293b;
    color: #94a3b8;
    padding: 2px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #334155;
    color: #e2e8f0;
}

QMenu {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #e2e8f0;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #eef2ff;
    color: #4f46e5;
}

/* ============================================================
   BOTONES
   ============================================================ */
QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    min-height: 16px;
}

QPushButton:focus {
    outline: 2px solid #a5b4fc;
    outline-offset: 1px;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #a5b4fc;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QPushButton#btnPrimary {
    background-color: #4f46e5;
    color: white;
    border: 1px solid #4f46e5;
}

QPushButton#btnPrimary:hover {
    background-color: #4338ca;
    border-color: #4338ca;
}

QPushButton#btnPrimary:pressed {
    background-color: #3730a3;
}

QPushButton#btnPrimary:disabled {
    background-color: #c7d2fe;
    color: #eef2ff;
    border-color: #c7d2fe;
}

QPushButton#btnSecondary {
    background-color: #ffffff;
    color: #4f46e5;
    border: 1px solid #4f46e5;
}

QPushButton#btnSecondary:hover {
    background-color: #eef2ff;
}

QPushButton#btnSecondary:pressed {
    background-color: #e0e7ff;
}

QPushButton#btnSecondary:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QPushButton#btnModo {
    background-color: #ffffff;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0px;
}

QPushButton#btnModo:hover {
    background-color: #eef2ff;
    border-color: #4f46e5;
}

QPushButton#btnModo:checked {
    background-color: #4f46e5;
    border-color: #4f46e5;
}

QPushButton#btnModo:checked:hover {
    background-color: #4338ca;
}

QPushButton#btnModo:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
}

QPushButton#btnSuccess {
    background-color: #059669;
    color: white;
    border: 1px solid #059669;
}

QPushButton#btnSuccess:hover {
    background-color: #047857;
}

QPushButton#btnSuccess:pressed {
    background-color: #065f46;
}

QPushButton#btnSuccess:disabled {
    background-color: #a7d7c6;
    color: #ecfdf5;
    border-color: #a7d7c6;
}

QPushButton#btnDanger {
    background-color: #dc2626;
    color: white;
    border: 1px solid #dc2626;
}

QPushButton#btnDanger:hover {
    background-color: #b91c1c;
}

QPushButton#btnDanger:pressed {
    background-color: #991b1b;
}

QPushButton#btnDanger:disabled {
    background-color: #f3a8a8;
    color: #fef2f2;
    border-color: #f3a8a8;
}

QPushButton#btnWarning {
    background-color: #d97706;
    color: white;
    border: 1px solid #d97706;
}

QPushButton#btnWarning:hover {
    background-color: #b45309;
}

QPushButton#btnWarning:pressed {
    background-color: #92400e;
}

QPushButton#btnWarning:disabled {
    background-color: #fcd34d;
    color: #fffbeb;
    border-color: #fcd34d;
}

QPushButton#btnRowEdit {
    background-color: #ffffff;
    border: 1px solid #4f46e5;
    border-radius: 17px;
    padding: 0px;
    min-height: 0px;
    max-height: 34px;
    max-width: 34px;
}

QPushButton#btnRowEdit:hover {
    background-color: #eef2ff;
}

QPushButton#btnRowEdit:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
}

QPushButton#btnRowDel {
    background-color: #ffffff;
    border: 1px solid #dc2626;
    border-radius: 17px;
    padding: 0px;
    min-height: 0px;
    max-height: 34px;
    max-width: 34px;
}

QPushButton#btnRowDel:hover {
    background-color: #fef2f2;
}

QPushButton#btnRowDel:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
}

QPushButton#btnLogin {
    background-color: #4f46e5;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 14px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#btnLogin:hover {
    background-color: #4338ca;
}

QPushButton#btnLogin:pressed {
    background-color: #3730a3;
}

/* ============================================================
   BARRA DE NAVEGACIÓN (sidebar oscuro elegante)
   ============================================================ */
QFrame#navPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1e293b, stop:1 #16202f);
    border-right: 1px solid #0f172a;
}

QPushButton#navToggle {
    background-color: transparent;
    color: #cbd5e1;
    border: none;
    border-radius: 6px;
    min-height: 30px;
    margin-bottom: 2px;
}

QPushButton#navToggle:hover {
    background-color: #334155;
    color: #e2e8f0;
}

QPushButton#navToggle:pressed {
    background-color: #1e293b;
}

QLabel#navSectionLabel {
    color: #64748b;
    font-size: 10px;
    font-weight: bold;
    padding: 8px 14px 2px 14px;
}

QPushButton#navButton {
    background-color: transparent;
    color: #cbd5e1;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    margin: 1px 8px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
}

QPushButton#navButton:hover {
    background-color: #334155;
    color: #e2e8f0;
}

QPushButton#navButton:checked {
    background-color: #4338ca;
    color: #ffffff;
}

QPushButton#navButton:checked:hover {
    background-color: #4f46e5;
}

QFrame#navDivider {
    background-color: #334155;
    border: none;
    min-height: 1px;
    max-height: 1px;
    margin: 6px 14px;
}

QFrame#userCard {
    background-color: #0f172a;
    border-radius: 8px;
    padding: 10px 12px;
    border: 1px solid #243244;
}

QLabel#userName {
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 600;
}

QLabel#userRole {
    color: #94a3b8;
    font-size: 11px;
}

QLabel#navBrand {
    color: #ffffff;
    font-weight: bold;
    font-size: 17px;
}

QLabel#navVersion {
    color: #475569;
    font-size: 11px;
}

/* ============================================================
   HEADERS DE VISTAS
   ============================================================ */
QFrame#headerBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

QLabel#sectionTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1e293b;
}

QLabel#sectionSubtitle {
    font-size: 12px;
    color: #64748b;
}

/* ============================================================
   TARJETAS
   ============================================================ */
QFrame#card {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

QFrame#card:hover {
    border: 1px solid #cbd5e1;
}

QLabel#imgPreview {
    background-color: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 12px;
}

/* Selector de vista estilo Odoo */
QPushButton#viewSwitch {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    min-height: 18px;
}

QPushButton#viewSwitch:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
}

QPushButton#viewSwitch:checked {
    background-color: #eef2ff;
    color: #4f46e5;
    border-color: #4f46e5;
}

/* Tarjetas kanban */
QFrame#odooCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QFrame#odooCard:hover {
    border: 1px solid #c7d2fe;
    background-color: #fafaff;
}

QFrame#odooCard[selected="true"] {
    border: 2px solid #4f46e5;
    background-color: #eef2ff;
}

QLabel#cardBadge {
    background-color: #eef2ff;
    color: #4f46e5;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#cardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #1e293b;
}

QLabel#cardValue {
    font-size: 28px;
    font-weight: bold;
    color: #4f46e5;
}

/* ============================================================
   TABLAS (espaciado generoso, filas aireadas)
   ============================================================ */
QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    font-size: 13px;
    color: #1e293b;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #f1f5f9;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #f8fafc;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #eef2ff;
    color: #4f46e5;
}

QTableWidget::item:selected:hover, QTableView::item:selected:hover {
    background-color: #e0e7ff;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    font-weight: bold;
    font-size: 11px;
    padding: 8px 8px;
    border: none;
    border-bottom: 2px solid #e2e8f0;
}

QTableCornerButton::section {
    background-color: #f8fafc;
    border: none;
    border-bottom: 2px solid #e2e8f0;
}

/* ============================================================
   TABS
   ============================================================ */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #64748b;
    padding: 7px 16px;
    font-size: 12px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #4f46e5;
    border-bottom: 2px solid #4f46e5;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #1e293b;
}

/* ============================================================
   GROUPBOX
   ============================================================ */
QGroupBox {
    background-color: #fafbfc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
    font-size: 12px;
    color: #334155;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #fafbfc;
}

/* ============================================================
   PROGRESSBAR
   ============================================================ */
QProgressBar {
    border: none;
    border-radius: 5px;
    background-color: #e2e8f0;
    height: 10px;
    text-align: center;
    font-size: 10px;
}

QProgressBar::chunk {
    background-color: #4f46e5;
    border-radius: 5px;
}

/* ============================================================
   KANBAN
   ============================================================ */
QFrame#kanbanCard {
    background-color: #ffffff;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    padding: 14px;
}

QFrame#kanbanCard:hover {
    border: 1px solid #4f46e5;
}

QLabel#kanbanTitle {
    font-size: 14px;
    font-weight: bold;
    color: #1e293b;
}

QLabel#kanbanStatus {
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 10px;
}

QLabel#kanbanStatus[estatus="pendiente"] {
    background-color: #fef3c7;
    color: #92400e;
}

QLabel#kanbanStatus[estatus="en_proceso"] {
    background-color: #dbeafe;
    color: #1e40af;
}

QLabel#kanbanStatus[estatus="completado"] {
    background-color: #d1fae5;
    color: #065f46;
}

/* ============================================================
   SCROLLBARS (estilo Windows 11: delgadas y sutiles)
   ============================================================ */
QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar:horizontal {
    height: 8px;
    background: transparent;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}

/* ============================================================
   SCROLLAREA
   ============================================================ */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* ============================================================
   LISTAS
   ============================================================ */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px;
    font-size: 13px;
    color: #1e293b;
}

QListWidget::item {
    padding: 4px 8px;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #f8fafc;
}

QListWidget::item:selected {
    background-color: #eef2ff;
    color: #4f46e5;
}

/* ============================================================
   STATUS BAR
   ============================================================ */
QStatusBar {
    background-color: #1e293b;
    color: #94a3b8;
    font-size: 12px;
    padding: 4px 8px;
}

QStatusBar QLabel {
    color: #94a3b8;
}

/* ============================================================
   TOOLTIP
   ============================================================ */
QToolTip {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
}

/* ============================================================
   MESSAGEBOX
   ============================================================ */
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    font-size: 13px;
    color: #1e293b;
}

QMessageBox QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    min-width: 88px;
}

QMessageBox QPushButton:hover {
    background-color: #f8fafc;
    border-color: #a5b4fc;
}

QMessageBox QPushButton:pressed {
    background-color: #e2e8f0;
}

QMessageBox QPushButton:default,
QMessageBox QPushButton#qt_msgbox_okbutton,
QMessageBox QPushButton#qt_msgbox_yesbutton,
QMessageBox QPushButton#qt_msgbox_yesallbutton {
    background-color: #4f46e5;
    color: #ffffff;
    border: none;
}

QMessageBox QPushButton:default:hover,
QMessageBox QPushButton#qt_msgbox_okbutton:hover,
QMessageBox QPushButton#qt_msgbox_yesbutton:hover,
QMessageBox QPushButton#qt_msgbox_yesallbutton:hover {
    background-color: #4338ca;
}

/* ---- InputDialog ---- */
QInputDialog QLabel {
    font-size: 13px;
    color: #1f2937;
}

QInputDialog QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    min-width: 88px;
}

QInputDialog QPushButton:hover {
    background-color: #f8fafc;
    border-color: #a5b4fc;
}

QInputDialog QPushButton:pressed {
    background-color: #e2e8f0;
}

QInputDialog QPushButton:default {
    background-color: #4f46e5;
    color: #ffffff;
    border: none;
}

QInputDialog QPushButton:default:hover {
    background-color: #4338ca;
}

/* ---- DialogButtonBox ---- */
QDialogButtonBox QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    min-width: 88px;
}

QDialogButtonBox QPushButton:hover {
    background-color: #f8fafc;
    border-color: #a5b4fc;
}

QDialogButtonBox QPushButton:pressed {
    background-color: #e2e8f0;
}

QDialogButtonBox QPushButton:default {
    background-color: #4f46e5;
    color: #ffffff;
    border: none;
}

QDialogButtonBox QPushButton:default:hover {
    background-color: #4338ca;
}

/* ============================================================
   CALENDARIO
   ============================================================ */
QCalendarWidget QWidget {
    background-color: #ffffff;
    font-size: 13px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #334155;
    font-weight: bold;
    padding: 6px 10px;
}

QCalendarWidget QToolButton:hover {
    background-color: #eef2ff;
}

QCalendarWidget QAbstractItemView {
    background-color: #ffffff;
    color: #1f2937;
    selection-background-color: #eef2ff;
    selection-color: #4f46e5;
    border: none;
}

QCalendarWidget QWidget#qt_calendar_weekday {
    color: #475569;
    font-weight: bold;
}

QCalendarWidget QSpinBox {
    font-size: 13px;
    padding: 4px;
}

/* ============================================================
   DIÁLOGO DE CONFIGURACIÓN (panel lateral tipo Windows)
   ============================================================ */
QDialog#dlgConfiguracion {
    background-color: #f5f6f8;
}

QLabel#cfgDialogTitle {
    background-color: #f5f6f8;
    font-size: 26px;
    font-weight: 700;
    color: #1e293b;
    padding: 20px 28px 12px 28px;
}

QFrame#cfgSidebar {
    background-color: #f5f6f8;
    border: none;
    border-right: 1px solid #e2e8f0;
}

QPushButton#cfgSidebarItem {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
    text-align: left;
}

QPushButton#cfgSidebarItem:hover {
    background-color: #e8eaed;
}

QPushButton#cfgSidebarItem:checked {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
}

QPushButton#cfgSidebarItem:checked:hover {
    background-color: #ffffff;
}

QLabel#cfgSidebarItemLabel {
    background-color: transparent;
    border: none;
    color: #1f2937;
    font-size: 14px;
    font-weight: 500;
}

QFrame#cfgContent {
    background-color: #f5f6f8;
    border: none;
}

QLabel#cfgSectionTitle {
    background-color: transparent;
    font-size: 18px;
    font-weight: 600;
    color: #1e293b;
}

QLabel#cfgSectionSubtitle {
    background-color: transparent;
    font-size: 12px;
    color: #64748b;
}

QFrame#cfgDivider {
    background-color: #e2e8f0;
    border: none;
}

/* ============================================================
   NOTIFICACIONES FLOTANTES (toast)
   ============================================================ */
QFrame#toastCard {
    background-color: #1e293b;
    border-radius: 10px;
    border: 1px solid #334155;
}

QLabel#toastTitulo {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
}

QLabel#toastMsg {
    color: #cbd5e1;
    font-size: 12px;
}

QPushButton#toastCerrar {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 14px;
}

QPushButton#toastCerrar:hover {
    background-color: #334155;
    color: #e2e8f0;
}
